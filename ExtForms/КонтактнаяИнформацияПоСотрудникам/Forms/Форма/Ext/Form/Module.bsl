&НаКлиенте
Процедура Сформировать(Команда)
    
    // Проверка: выбрана ли организация (если нет — просто выходим)
	Если Организация = Неопределено Или Организация.Пустая() Тогда 
		
		Возврат;
    КонецЕсли;
    
    // Вызываем серверную процедуру, передавая ей нужные параметры
    СформироватьНаСервере(Организация, ПоказатьТолькоНеполные);
    
КонецПроцедуры


&НаСервере
Процедура СформироватьНаСервере(Организация, ПоказатьТолькоНеполные)
    
    ТабДок.Очистить();
    
    // 1. Формируем запрос
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Сотрудники.Ссылка КАК Сотрудник,
        |    Сотрудники.Наименование КАК ФИО,
        |    ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
        |    ЕСТЬNULL(МобТел.Представление, """") КАК МобильныйТелефон,
        |    ВЫБОР
        |        КОГДА МобТел.Ссылка ЕСТЬ NULL
        |            ТОГДА ЛОЖЬ
        |        ИНАЧЕ ИСТИНА
        |    КОНЕЦ КАК ЕстьМобильныйТелефон,
        |    ЕСТЬNULL(РабТел.Представление, """") КАК РабочийТелефон,
        |    ВЫБОР
        |        КОГДА РабТел.Ссылка ЕСТЬ NULL
        |            ТОГДА ЛОЖЬ
        |        ИНАЧЕ ИСТИНА
        |    КОНЕЦ КАК ЕстьРабочийТелефон,
        |    ВЫБОР
        |        КОГДА Фото.ФизическоеЛицо ЕСТЬ NULL
        |            ТОГДА ЛОЖЬ
        |        ИНАЧЕ ИСТИНА
        |    КОНЕЦ КАК ЕстьФотография
        |ИЗ
        |    Справочник.Сотрудники КАК Сотрудники
        |    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
        |        ПО Сотрудники.ФизическоеЛицо = ФизическиеЛица.Ссылка
        |    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК МобТел
        |        ПО ФизическиеЛица.Ссылка = МобТел.Ссылка
        |        И МобТел.Вид.Наименование = ""Мобильный телефон""
        |    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
        |        ПО ФизическиеЛица.Ссылка = Пользователи.ФизическоеЛицо
        |    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК РабТел
        |        ПО Пользователи.Ссылка = РабТел.Ссылка
        |        И РабТел.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
        |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФотографииФизическихЛиц КАК Фото
        |        ПО ФизическиеЛица.Ссылка = Фото.ФизическоеЛицо
        |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИстория
        |        ПО Сотрудники.Ссылка = КадроваяИстория.Сотрудник
        |ГДЕ
        |    НЕ Сотрудники.ПометкаУдаления
        |    И НЕ ФизическиеЛица.ПометкаУдаления
        |    И Сотрудники.ГоловнаяОрганизация = &ГоловнаяОрганизация
        |    И КадроваяИстория.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ТрудовойДоговор)
        |    И НЕ КадроваяИстория.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
        |УПОРЯДОЧИТЬ ПО
        |    ФИО";
        
    Запрос.УстановитьПараметр("ГоловнаяОрганизация", Организация);
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    Если Выборка.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // 4. Подготавливаем табличный документ
    
    ОбластьЗаголовок = ТабДок.ПолучитьОбласть("R1C1:R1C7");
    
    // Вместо объединения просто пишем текст в первую ячейку
    // (Убираем строку с Объединить())
    ОбластьЗаголовок.Область("R1C1").Текст = "Отчет по контактной информации сотрудников";
    ОбластьЗаголовок.Область("R1C1").Шрифт = Новый Шрифт(, 12, Истина); 
    ТабДок.Вывести(ОбластьЗаголовок);	
	
	
    
    // --- ШАПКА ---
    // Создаем строку для шапки
    ОбластьШапка = ТабДок.ПолучитьОбласть("R2C1:R2C7");
    
    // Записываем текст в каждую ячейку отдельно (R = строка, C = колонка)
    ОбластьШапка.Область("R2C1").Текст = "№";
    ОбластьШапка.Область("R2C2").Текст = "ФИО";
    ОбластьШапка.Область("R2C3").Текст = "Мобильный телефон";
    ОбластьШапка.Область("R2C4").Текст = "Рабочий телефон";
    ОбластьШапка.Область("R2C5").Текст = "Есть моб. телефон";
    ОбластьШапка.Область("R2C6").Текст = "Есть раб. телефон";
    ОбластьШапка.Область("R2C7").Текст = "Есть фото";
    
    // Делаем шрифт жирным для всех ячеек шапки
    ОбластьШапка.Область("R2C1").Шрифт = Новый Шрифт(, , Истина);
    ОбластьШапка.Область("R2C2").Шрифт = Новый Шрифт(, , Истина);
    ОбластьШапка.Область("R2C3").Шрифт = Новый Шрифт(, , Истина);
    ОбластьШапка.Область("R2C4").Шрифт = Новый Шрифт(, , Истина);
    ОбластьШапка.Область("R2C5").Шрифт = Новый Шрифт(, , Истина);
    ОбластьШапка.Область("R2C6").Шрифт = Новый Шрифт(, , Истина);
    ОбластьШапка.Область("R2C7").Шрифт = Новый Шрифт(, , Истина);
    
    ТабДок.Вывести(ОбластьШапка);
    
    // Задаем ширину колонок
    ТабДок.Область("C1").ШиринаКолонки = 5;
    ТабДок.Область("C2").ШиринаКолонки = 35;
    ТабДок.Область("C3").ШиринаКолонки = 20;
    ТабДок.Область("C4").ШиринаКолонки = 20;
    ТабДок.Область("C5").ШиринаКолонки = 15;
    ТабДок.Область("C6").ШиринаКолонки = 15;
    ТабДок.Область("C7").ШиринаКолонки = 10;
    
    // 5. Выводим строки данных
    Счетчик = 1;
    
    Пока Выборка.Следующий() Цикл
        
        Если ПоказатьТолькоНеполные Тогда
            Если Выборка.ЕстьМобильныйТелефон И Выборка.ЕстьРабочийТелефон И Выборка.ЕстьФотография Тогда
                Продолжить; 
            КонецЕсли;
        КонецЕсли;
        
        ОбластьСтрока = ТабДок.ПолучитьОбласть("R3C1:R3C7");
        
        ОбластьСтрока.Область("R3C1").Текст = Строка(Счетчик);
        ОбластьСтрока.Область("R3C2").Текст = Выборка.ФИО;
        ОбластьСтрока.Область("R3C3").Текст = Выборка.МобильныйТелефон;
        ОбластьСтрока.Область("R3C4").Текст = Выборка.РабочийТелефон;
        ОбластьСтрока.Область("R3C5").Текст = ?(Выборка.ЕстьМобильныйТелефон, "Да", "Нет");
        ОбластьСтрока.Область("R3C6").Текст = ?(Выборка.ЕстьРабочийТелефон, "Да", "Нет");
        ОбластьСтрока.Область("R3C7").Текст = ?(Выборка.ЕстьФотография, "Да", "Нет");
        
        ТабДок.Вывести(ОбластьСтрока);
        Счетчик = Счетчик + 1;
        
    КонецЦикла;
    
    Если Счетчик = 1 Тогда
        ТабДок.Очистить(); 
    Иначе
        ТабДок.ТолькоПросмотр = Истина; 
    КонецЕсли;
    
КонецПроцедуры